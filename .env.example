# -----------------------------------------------------------------------------
# AdventureConnect Backend Environment Variables Example
# -----------------------------------------------------------------------------
#
# INSTRUCTIONS:
# 1. Rename this file to '.env' in the 'backend' directory.
# 2. Fill in the actual values for each variable below.
# 3. DO NOT commit your actual '.env' file to version control.
#    This '.env.example' file is safe to commit as a template.
#
# For development, these variables will be loaded automatically if the '.env'
# file exists in the 'backend' directory.
# For production, these variables should be set directly in your deployment environment.
#
# -----------------------------------------------------------------------------

# --- Application Environment ---
# Sets the application environment.
# Recommended values: 'development', 'test', 'production'
NODE_ENV=development

# --- Server Configuration ---
# Port the backend server will listen on.
PORT=5000

# --- Logging Configuration ---
# Log level for Winston logger.
# Recommended: 'debug' for development, 'info' or 'warn' for production.
LOG_LEVEL=debug

# --- Database Configuration (PostgreSQL) ---
# Connection string for your PostgreSQL database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Example: postgresql://adventure_user:strongpassword123@localhost:5432/adventureconnect_db
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/your_database_name

# --- Redis Configuration ---
# Connection string for your Redis instance (optional, but recommended for caching/sessions).
# Format: redis://HOST:PORT or redis://USER:PASSWORD@HOST:PORT
# Example: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# --- Authentication (JWT) ---
# IMPORTANT: This is a CRITICAL secret.
# Use a strong, unique, randomly generated string (at least 32 characters long).
# DO NOT use weak or default secrets in production.
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_very_strong_and_unique_jwt_secret_of_at_least_32_characters
# How long an access token is valid for (e.g., 1h, 1d, 30m).
JWT_EXPIRES_IN=24h

# --- CSRF Protection ---
# Lifetime (in seconds) of the issued CSRF tokens.
# The backend will refuse a token older than this value.
# Default is 900 seconds (15 minutes). Increase for long-lived sessions,
# lower for stricter security.
CSRF_TOKEN_TTL_SECONDS=900

# --- CORS Configuration ---
# Comma-separated list of allowed origins for CORS.
# For development, this is typically your frontend's URL.
# Example: http://localhost:3000,https://your-staging-frontend.com
CORS_ORIGIN=http://localhost:3000

# --- External API Keys ---
# These keys are required for integrating with third-party services.
# Obtain these keys from the respective service providers.

# RapidAPI Key (used for various services like Booking.com, Hotels.com alternatives, GetYourGuide, Viator)
# REQUIRED if using these services.
RAPIDAPI_KEY=your_rapidapi_key_here

# FlightAPI.io Key (for flight searches)
# REQUIRED for flight search functionality.
FLIGHT_API_KEY=your_flightapi_io_key_here

# Amadeus API Credentials (for flight/hotel/etc. - primary integration)
# REQUIRED if using Amadeus services.
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here
# AMADEUS_HOSTNAME can be 'test' or 'production'
AMADEUS_HOSTNAME=test

# OpenWeatherMap API Key (for weather forecasts)
# Optional, but recommended for weather features.
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Google Gemini API Key (for AI-powered recommendations/optimizations)
# Optional, for AI features.
GEMINI_API_KEY=your_google_gemini_api_key_here

# MakCorps API Key (alternative hotel API, if used)
# Optional, depending on which hotel provider is active.
MAKCORPS_API_KEY=your_makcorps_api_key_here

# Add other API keys as needed, for example:
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# STRIPE_SECRET_KEY=your_stripe_secret_key_here (for payments)

# --- Application Specific Settings ---
# Base URL for the FlightAPI.io service (can usually be left as default)
# FLIGHT_API_BASE_URL=https://api.flightapi.io

# -----------------------------------------------------------------------------
# SECURITY WARNING:
# - Never commit your actual '.env' file (with real secrets) to Git.
# - Ensure your '.gitignore' file includes '.env'.
# - Use strong, unique passwords and API keys.
# - Regularly rotate secrets and API keys, especially if a compromise is suspected.
# - For production, use a secure secret management system provided by your
#   hosting platform (e.g., AWS Secrets Manager, Azure Key Vault, Docker Secrets,
#   Kubernetes Secrets, or environment variables set directly on the server).
# -----------------------------------------------------------------------------
